#pragma code_page(65001)
#include <windows.h>
#include "question_editor_ids.h"

IDI_RESPONDER ICON "..\\assets\\favicon.ico"

IDD_QUESTION DIALOGEX 0, 0, 380, 336
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "题目编辑"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "题型", -1, 16, 16, 26, 12
    COMBOBOX QE_TYPE, 44, 13, 96, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "难度", -1, 154, 16, 26, 12
    COMBOBOX QE_LEVEL, 182, 13, 102, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "", QE_BADGE, 290, 16, 74, 12
    LTEXT "题干内容", QE_STEM_LABEL, 16, 40, 220, 12
    EDITTEXT QE_STEM, 16, 55, 348, 54, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "四个选项（依次为 A、B、C、D）", QE_EXTRA_LABEL, 16, 120, 348, 12
    LTEXT "A.", QE_PREFIX1, 16, 138, 28, 13
    EDITTEXT QE_LINE1, 48, 136, 316, 16, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "B.", QE_PREFIX2, 16, 159, 28, 13
    EDITTEXT QE_LINE2, 48, 157, 316, 16, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "C.", QE_PREFIX3, 16, 180, 28, 13
    EDITTEXT QE_LINE3, 48, 178, 316, 16, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "D.", QE_PREFIX4, 16, 201, 28, 13
    EDITTEXT QE_LINE4, 48, 199, 316, 16, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "参考答案", QE_ANS_LABEL, 16, 226, 220, 12
    EDITTEXT QE_ANSWER, 16, 241, 348, 38, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "", QE_FEEDBACK, 16, 286, 348, 14
    CONTROL "保存", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 244, 306, 56, 20
    CONTROL "取消", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 308, 306, 56, 20
END
