#pragma code_page(65001)
#include <windows.h>
#include "question_editor_ids.h"

IDI_RESPONDER ICON "..\\assets\\favicon.ico"

IDD_QUESTION DIALOGEX 0, 0, 384, 346
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "题目编辑"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "题型", -1, 16, 16, 26, 12
    CONTROL "", QE_TYPE, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 44, 12, 96, 18
    LTEXT "难度", -1, 154, 16, 26, 12
    CONTROL "", QE_LEVEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 182, 12, 102, 18
    RTEXT "", QE_BADGE, 290, 16, 78, 12
    LTEXT "题干内容", QE_STEM_LABEL, 16, 40, 220, 12
    EDITTEXT QE_STEM, 21, 58, 342, 48, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "四个选项（依次为 A、B、C、D）", QE_EXTRA_LABEL, 16, 118, 348, 12
    LTEXT "A.", QE_PREFIX1, 16, 139, 28, 12
    EDITTEXT QE_LINE1, 52, 139, 311, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "B.", QE_PREFIX2, 16, 162, 28, 12
    EDITTEXT QE_LINE2, 52, 162, 311, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "C.", QE_PREFIX3, 16, 185, 28, 12
    EDITTEXT QE_LINE3, 52, 185, 311, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "D.", QE_PREFIX4, 16, 208, 28, 12
    EDITTEXT QE_LINE4, 52, 208, 311, 12, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "参考答案", QE_ANS_LABEL, 16, 234, 220, 12
    EDITTEXT QE_ANSWER, 21, 252, 342, 34, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT "", QE_FEEDBACK, 16, 294, 352, 14
    CONTROL "保存", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 248, 314, 56, 20
    CONTROL "取消", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 312, 314, 56, 20
END
