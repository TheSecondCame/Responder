#pragma code_page(65001)
#include <windows.h>
#include "question_editor_ids.h"

IDD_QUESTION DIALOGEX 0, 0, 332, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "题目编辑"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "题型", -1, 12, 15, 28, 12
    COMBOBOX QE_TYPE, 47, 12, 101, 76, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "难度", -1, 170, 15, 28, 12
    COMBOBOX QE_LEVEL, 204, 12, 116, 86, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "题干", -1, 12, 40, 220, 12
    EDITTEXT QE_STEM, 12, 54, 308, 49, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "选项（依次为 A、B、C、D）", QE_EXTRA_LABEL, 12, 111, 307, 12
    EDITTEXT QE_LINE1, 12, 126, 308, 14, ES_AUTOHSCROLL
    EDITTEXT QE_LINE2, 12, 144, 308, 14, ES_AUTOHSCROLL
    EDITTEXT QE_LINE3, 12, 162, 308, 14, ES_AUTOHSCROLL
    EDITTEXT QE_LINE4, 12, 180, 308, 14, ES_AUTOHSCROLL
    LTEXT "答案", -1, 12, 204, 200, 12
    EDITTEXT QE_ANSWER, 12, 219, 308, 33, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", QE_FEEDBACK, 12, 256, 308, 14
    DEFPUSHBUTTON "保存", IDOK, 211, 276, 52, 17
    PUSHBUTTON "取消", IDCANCEL, 268, 276, 52, 17
END
